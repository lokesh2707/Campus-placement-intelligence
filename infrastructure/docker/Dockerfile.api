FROM node:22-alpine AS base

WORKDIR /app

# Install dependencies needed for build
COPY package.json ./
COPY packages ./packages
COPY apps/api ./apps/api

# Install and build
RUN npm install
RUN npm run build --workspace=@campus-os/shared-types
RUN npm run build --workspace=@campus-os/config
RUN npm run build --workspace=@campus-os/validation
WORKDIR /app/apps/api
RUN npx prisma generate
RUN npm run build

EXPOSE 4000

ENV NODE_ENV=production
CMD ["node", "dist/server.js"]
