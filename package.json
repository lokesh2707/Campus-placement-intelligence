{
  "name": "campus-placement-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Campus Placement Intelligence & Management Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@campus-os/api --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@campus-os/api",
    "dev:web": "npm run dev --workspace=@campus-os/web",
    "dev:mobile": "npm run start --workspace=@campus-os/mobile",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  }
}
