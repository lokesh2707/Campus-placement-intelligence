# ==============================================================================
# AI-Powered Campus Placement Intelligence Platform - Environment Configuration
# All defaults are pre-configured for ₹0 local development without paid services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Service (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
MOBILE_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:3000

# PostgreSQL with pgvector extension
DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campus_placement?schema=public"

# Redis Cache (Optional for basic local dev; graceful degradation enabled)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

# Authentication Secrets (Generate secure 64-char strings for production)
JWT_ACCESS_SECRET="dev_access_secret_super_secure_key_campus_os_2026"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_key_campus_os_2026"

# Storage Service Configuration
# Choices: "local" (default ₹0 local disk) | "cloud" (optional S3/MinIO)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./uploads"

# ML Microservice URL
ML_SERVICE_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# 2. Web Application (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 3. Mobile Application (apps/mobile)
# ------------------------------------------------------------------------------
# Use 10.0.2.2 for Android Emulator, localhost for iOS simulator, or LAN IP for physical device
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ------------------------------------------------------------------------------
# 4. AI/ML Python Service (apps/ml)
# ------------------------------------------------------------------------------
PYTHON_ENV=development
ML_PORT=8000

# AI Provider Strategy: "ollama" (local open-source ₹0 default) | "external" (optional cloud)
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# ------------------------------------------------------------------------------
# 5. Database Infrastructure (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=campus_password
POSTGRES_DB=campus_placement
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
