datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  SUPER_ADMIN
  PLACEMENT_ADMIN
  PLACEMENT_COORDINATOR
  DEPARTMENT_COORDINATOR
  RECRUITER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AcademicVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum WorkPreference {
  ONSITE
  HYBRID
  REMOTE
  ANY
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_REQUESTED
  SESSION_CREATED
  SESSION_REVOKED
  TOKEN_REFRESH_SUCCESS
  TOKEN_REFRESH_REUSE_DETECTED
  USER_REGISTERED
  // Phase 3 Student & Academic Events
  STUDENT_CREATED
  STUDENT_UPDATED
  ACADEMIC_INFO_UPDATED
  ACADEMIC_INFO_VERIFIED
  ACADEMIC_INFO_REJECTED
  SKILL_UPDATED
  RESUME_UPLOADED
  RESUME_DELETED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role        @default(STUDENT)
  status        UserStatus  @default(PENDING_VERIFICATION)
  emailVerified Boolean     @default(false)
  lastLoginAt   DateTime?
  collegeId     String?
  departmentId  String?
  companyId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  studentProfile          StudentProfile?
  verifiedStudents        StudentProfile[]         @relation("VerifiedStudents")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([collegeId])
  @@index([departmentId])
  @@index([companyId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id        String         @id @default(uuid())
  userId    String?
  event     AuditEventType
  requestId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  timestamp DateTime       @default(now())

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([timestamp])
}

model StorageRecord {
  id               String   @id @default(uuid())
  fileKey          String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  storageProvider  String   // 'local' | 'cloud'
  storagePath      String
  uploadedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fileKey])
  @@index([uploadedBy])
}

// ==========================================
// Phase 3 — Academic Structure Models
// ==========================================

model College {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  website   String?
  location  String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  campuses        Campus[]
  departments     Department[]
  studentProfiles StudentProfile[]

  @@index([code])
}

model Campus {
  id        String   @id @default(uuid())
  name      String
  code      String
  location  String?
  collegeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, code])
  @@index([collegeId])
}

model Department {
  id        String       @id @default(uuid())
  name      String
  code      String
  status    RecordStatus @default(ACTIVE)
  collegeId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  college         College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  degrees         Degree[]
  studentProfiles StudentProfile[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

model Degree {
  id           String   @id @default(uuid())
  name         String
  code         String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  batches         Batch[]
  studentProfiles StudentProfile[]

  @@unique([departmentId, code])
  @@index([departmentId])
}

model Batch {
  id        String   @id @default(uuid())
  name      String
  startYear Int
  endYear   Int
  degreeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  degree          Degree           @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  studentProfiles StudentProfile[]

  @@unique([degreeId, name])
  @@index([degreeId])
}

// ==========================================
// Phase 3 — Student Domain Models
// ==========================================

model StudentProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  studentId          String                     @unique // Registration / Roll Number
  collegeId          String
  departmentId       String
  degreeId           String
  batchId            String
  graduationYear     Int
  dateOfBirth        DateTime?
  gender             String?
  phone              String?
  cgpa               Float?
  tenthPercentage    Float?
  twelfthPercentage  Float?
  diplomaPercentage  Float?
  backlogs           Int                        @default(0)
  activeBacklogs     Int                        @default(0)
  profilePhoto       String?
  bio                String?
  verificationStatus AcademicVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  verificationNotes  String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college          College                 @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department       Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  degree           Degree                  @relation(fields: [degreeId], references: [id], onDelete: Restrict)
  batch            Batch                   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  verifiedBy       User?                   @relation("VerifiedStudents", fields: [verifiedById], references: [id], onDelete: SetNull)
  skills           StudentSkill[]
  projects         StudentProject[]
  internships      StudentInternship[]
  certifications   StudentCertification[]
  careerPreference StudentCareerPreference?
  resumes          Resume[]

  @@index([userId])
  @@index([studentId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([degreeId])
  @@index([batchId])
  @@index([verificationStatus])
  @@index([graduationYear])
  @@index([cgpa])
}

model Skill {
  id          String       @id @default(uuid())
  name        String       @unique
  category    String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  studentSkills StudentSkill[]

  @@index([name])
  @@index([category])
}

model StudentSkill {
  id                String           @id @default(uuid())
  studentProfileId  String
  skillId           String
  proficiency       SkillProficiency @default(INTERMEDIATE)
  yearsOfExperience Float            @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
}

model StudentProject {
  id               String    @id @default(uuid())
  studentProfileId String
  title            String
  description      String
  technologies     String[]
  role             String?
  projectUrl       String?
  githubUrl        String?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model StudentInternship {
  id                 String                     @id @default(uuid())
  studentProfileId   String
  companyName        String
  role               String
  description        String
  location           String?
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean                    @default(false)
  technologies       String[]
  documentUrl        String?
  verificationStatus AcademicVerificationStatus @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model StudentCertification {
  id               String    @id @default(uuid())
  studentProfileId String
  name             String
  issuer           String
  issueDate        DateTime
  expiryDate       DateTime?
  credentialId     String?
  credentialUrl    String?
  documentUrl      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model StudentCareerPreference {
  id                 String         @id @default(uuid())
  studentProfileId   String         @unique
  preferredRoles     String[]
  preferredLocations String[]
  remotePreference   Boolean        @default(false)
  minimumSalary      Float?
  preferredSalary    Float?
  currency           String         @default("INR")
  workPreference     WorkPreference @default(ANY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model Resume {
  id               String   @id @default(uuid())
  studentProfileId String
  fileKey          String
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  version          Int      @default(1)
  isActive         Boolean  @default(false)
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([fileKey])
  @@index([isActive])
}
